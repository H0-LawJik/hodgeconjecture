module

public import HodgeLadder.General.Segre
public import HodgeLadder.Tests.ProjectivePlane

/-!
# The Segre embedding `ℙᵐ × ℙⁿ ⟶ ℙ^{(m+1)(n+1)−1}`, and products of projective objects

Rung `segre-general`. The checked `ℙ¹ × ℙ¹ ⟶ ℙ³` of `HodgeLadder.General.Segre`, for all `m`, `n`
and over any commutative ring `R`. With `N := mn + m + n` (so `N + 1 = (m + 1)(n + 1)`,
`segreDim_add_one`), the Segre morphism `segre R m n : ℙₒ(m; R) ×_R ℙₒ(n; R) ⟶ ℙₒ(N; R)` is glued
(`HodgeLadder.Segre.glue`) from the `(m + 1)(n + 1)` products of standard charts, with homogeneous
coordinates `x_{(k, l)} = aₖ bₗ` on `D₊(a_i) × D₊(b_j)`. The pair `(k, l)` is the coordinate
`l + (n + 1) k` (`pairEquiv`, Mathlib's `finProdFinEquiv`, lexicographic), the order of the
`m = n = 1` case, and `segre R 1 1` is the checked map by `rfl` (`segre_one_one`).

It lies over `Spec R` (`segre_toSpec`) and is a closed immersion (`isClosedImmersion_segre`): the
preimage of `D₊(x_{(k, l)})` is the piece `(k, l)` (`segre_preimage`), and there the map is `Spec`
of a surjection (`awayEvalOf_segre_surjective`), since the coordinate ring of a product of affine
charts is generated by the two factors.

For `X`, `Y` in `Over (Spec ℂ)` with projective presentations `X ⟶ ℙᵈ`, `Y ⟶ ℙᵉ` (upstream's
`IsProjective`), `prodImmersion` is the closed immersion `X × Y ⟶ ℙₒ(d; ℂ) ×_ℂ ℙₒ(e; ℂ)` (closed
immersions are stable under base change and composition), and `prodPresentation` follows it by
the Segre embedding and `okaIsoSpace`. This gives the instance `isProjective_prod`.

## Main definitions

* `HodgeLadder.Segre.General.segreDim`, `prodP`, `prodCover`, `pairEquiv`, `segreF`, `segre`
* `HodgeLadder.Segre.General.prodImmersion`, `prodPresentation`

## Main results

* `HodgeLadder.Segre.General.segreF_X`, `pairEquiv_val`, `segre_toSpec`, `segre_preimage`,
  `isClosedImmersion_segre`, `segre_one_one`
* `HodgeLadder.Segre.General.isClosedImmersion_prodImmersion`
* instance `HodgeLadder.Segre.General.isProjective_prod`: `IsProjective (X ⨯ Y).hom`
* test `HodgeLadder.Segre.General.isProjective_p1p2`: ℙ¹ × ℙ² over ℂ is projective
* test `HodgeLadder.Segre.General.not_isProjective_affineLine`: the affine line over ℂ is not
  projective
-/

@[expose] public noncomputable section

open CategoryTheory Limits AlgebraicGeometry MvPolynomial HomogeneousLocalization
open scoped AlgebraicGeometry.ProjectiveSpace

namespace HodgeLadder.Segre.General

open AlgebraicGeometry.ProjectiveSpace

variable (R : Type) [CommRing R] (m n : ℕ)

/-- The dimension `(m + 1)(n + 1) − 1 = mn + m + n` of the target of the Segre map. -/
abbrev segreDim : ℕ := m * n + m + n

/-- The target of the Segre map has `(m + 1)(n + 1)` homogeneous coordinates. -/
theorem segreDim_add_one : segreDim m n + 1 = (m + 1) * (n + 1) := by
  simp only [segreDim]; ring

/-- `ℙᵐ ×_R ℙⁿ`, as the fibre product of Oka's `ℙₒ(m; R)` and `ℙₒ(n; R)` over `Spec R`. -/
abbrev prodP : Scheme := pullback (toSpec m R) (toSpec n R)

/-- The cover of `ℙᵐ × ℙⁿ` by the `(m + 1)(n + 1)` products of standard charts. -/
abbrev prodCover : (prodP R m n).OpenCover :=
  Scheme.Pullback.openCoverOfLeftRight (affineOpenCover m R).openCover
    (affineOpenCover n R).openCover (toSpec m R) (toSpec n R)

/-- The indexing of the coordinates of `ℙ^{mn+m+n}` by pairs, lexicographically:
`(k, l) ↦ k (n + 1) + l` (Mathlib's `finProdFinEquiv`). -/
def pairEquiv : Fin (m + 1) × Fin (n + 1) ≃ Fin (segreDim m n + 1) :=
  finProdFinEquiv.trans (finCongr (segreDim_add_one m n).symm)

/-- `pairEquiv (k, l) = k (n + 1) + l`. -/
theorem pairEquiv_val (k : Fin (m + 1)) (l : Fin (n + 1)) :
    (pairEquiv m n (k, l) : ℕ) = l + (n + 1) * k := by
  simp [pairEquiv, finProdFinEquiv]

/-- The first chart coordinate on a piece of the cover. -/
abbrev chartFst (a : Fin (m + 1) × Fin (n + 1)) :
    (prodCover R m n).X a ⟶ Spec (.of (MvPolynomial (Fin m) R)) := pullback.fst _ _

/-- The second chart coordinate on a piece of the cover. -/
abbrev chartSnd (a : Fin (m + 1) × Fin (n + 1)) :
    (prodCover R m n).X a ⟶ Spec (.of (MvPolynomial (Fin n) R)) := pullback.snd _ _

/-- The Segre coordinates `x_{kl} = a_k b_l` on a piece of the cover. -/
def segreF (a : Fin (m + 1) × Fin (n + 1)) :
    MvPolynomial (Fin (segreDim m n + 1)) R →+* Γ((prodCover R m n).X a, ⊤) :=
  eval₂Hom ((sharp (chartFst R m n a)).comp C) fun x =>
    sharp (chartFst R m n a) (dehomogenize R a.1 (X ((pairEquiv m n).symm x).1)) *
      sharp (chartSnd R m n a) (dehomogenize R a.2 (X ((pairEquiv m n).symm x).2))

/-- The Segre coordinate `x_{(k, l)}` on a piece is `aₖ bₗ`. -/
theorem segreF_X (a : Fin (m + 1) × Fin (n + 1)) (k : Fin (m + 1)) (l : Fin (n + 1)) :
    segreF R m n a (X (pairEquiv m n (k, l))) =
      sharp (chartFst R m n a) (dehomogenize R a.1 (X k)) *
        sharp (chartSnd R m n a) (dehomogenize R a.2 (X l)) := by
  simp [segreF]

/-- The chart index of a piece of the cover. -/
abbrev segreIdx (a : Fin (m + 1) × Fin (n + 1)) : Fin (segreDim m n + 1) :=
  pairEquiv m n (a.1, a.2)

/-- The chart coordinate of a piece equals `1` there. -/
theorem segreF_X_self (a : Fin (m + 1) × Fin (n + 1)) :
    segreF R m n a (X (segreIdx m n a)) = 1 := by
  rw [segreF_X R m n a a.1 a.2, dehomogenize_X_self (n := m) (R := R) a.1,
    dehomogenize_X_self (n := n) (R := R) a.2, map_one, map_one, mul_one]

/-- The chart coordinate of a piece is a unit there. -/
theorem segreF_unit (a : Fin (m + 1) × Fin (n + 1)) :
    IsUnit (segreF R m n a (X (segreIdx m n a))) := by
  rw [segreF_X_self]; exact isUnit_one

/-- The first projection of a piece is the first chart coordinate followed by the chart. -/
@[reassoc]
theorem prodCover_f_fst (a : Fin (m + 1) × Fin (n + 1)) :
    (prodCover R m n).f a ≫ pullback.fst (toSpec m R) (toSpec n R) =
      chartFst R m n a ≫ chart a.1 :=
  pullback.lift_fst _ _ _

/-- The second projection of a piece is the second chart coordinate followed by the chart. -/
@[reassoc]
theorem prodCover_f_snd (a : Fin (m + 1) × Fin (n + 1)) :
    (prodCover R m n).f a ≫ pullback.snd (toSpec m R) (toSpec n R) =
      chartSnd R m n a ≫ chart a.2 :=
  pullback.lift_snd _ _ _

/-- On the overlap of two pieces the Segre coordinates agree up to a unit. -/
theorem segre_hX (a b : Fin (m + 1) × Fin (n + 1)) :
    ∃ c : Γ(pullback ((prodCover R m n).f a) ((prodCover R m n).f b), ⊤)ˣ, ∀ k,
      (pullback.fst ((prodCover R m n).f a) ((prodCover R m n).f b)).appTop
          (segreF R m n a (X k)) =
        c * (pullback.snd ((prodCover R m n).f a) ((prodCover R m n).f b)).appTop
          (segreF R m n b (X k)) := by
  have h1 : (pullback.fst ((prodCover R m n).f a) ((prodCover R m n).f b) ≫ chartFst R m n a) ≫
        chart a.1 =
      (pullback.snd ((prodCover R m n).f a) ((prodCover R m n).f b) ≫ chartFst R m n b) ≫
        chart b.1 := by
    rw [Category.assoc, Category.assoc, ← prodCover_f_fst, ← prodCover_f_fst,
      pullback.condition_assoc]
  have h2 : (pullback.fst ((prodCover R m n).f a) ((prodCover R m n).f b) ≫ chartSnd R m n a) ≫
        chart a.2 =
      (pullback.snd ((prodCover R m n).f a) ((prodCover R m n).f b) ≫ chartSnd R m n b) ≫
        chart b.2 := by
    rw [Category.assoc, Category.assoc, ← prodCover_f_snd, ← prodCover_f_snd,
      pullback.condition_assoc]
  obtain ⟨c₁, hc₁⟩ := exists_unit_of_comp_chart_eq _ _ _ _ h1
  obtain ⟨c₂, hc₂⟩ := exists_unit_of_comp_chart_eq _ _ _ _ h2
  refine ⟨c₁ * c₂, fun x => ?_⟩
  obtain ⟨⟨k, l⟩, rfl⟩ := (pairEquiv m n).surjective x
  rw [segreF_X, segreF_X, map_mul, map_mul]
  have e1 := hc₁ k
  have e2 := hc₂ l
  rw [sharp_comp, sharp_comp] at e1 e2
  simp only [RingHom.comp_apply] at e1 e2
  rw [e1, e2, Units.val_mul]
  ring

/-- On the overlap of two pieces the Segre coordinates have the same constants. -/
theorem segre_hC (a b : Fin (m + 1) × Fin (n + 1)) (r : R) :
    (pullback.fst ((prodCover R m n).f a) ((prodCover R m n).f b)).appTop
        (segreF R m n a (C r)) =
      (pullback.snd ((prodCover R m n).f a) ((prodCover R m n).f b)).appTop
        (segreF R m n b (C r)) := by
  have h := pullback.condition_assoc (f := (prodCover R m n).f a) (g := (prodCover R m n).f b)
    (pullback.fst (toSpec m R) (toSpec n R) ≫ toSpec m R)
  rw [prodCover_f_fst_assoc, prodCover_f_fst_assoc, chart_toSpec, chart_toSpec] at h
  have := congr(sharp $h r)
  simp only [← Category.assoc] at this
  rw [sharp_comp_SpecMap, sharp_comp_SpecMap, sharp_comp, sharp_comp] at this
  simpa [segreF] using this

/-- **The Segre morphism** `ℙᵐ ×_R ℙⁿ ⟶ ℙ^{mn+m+n}`, `([a₀ : … : a_m], [b₀ : … : b_n]) ↦ [aₖ bₗ]`,
with the coordinate `x_{(k, l)}` indexed through `pairEquiv`. -/
def segre : prodP R m n ⟶ ℙₒ(segreDim m n; R) :=
  glue (prodCover R m n) (fun a => segreF R m n a) (fun a => segreIdx m n a)
    (fun a => segreF_unit R m n a) (fun a b => segre_hX R m n a b)
    (fun a b r => segre_hC R m n a b r)

/-- On each piece, the Segre morphism is the `Z`-point with the Segre coordinates. -/
theorem prodCover_f_segre (a : Fin (m + 1) × Fin (n + 1)) :
    (prodCover R m n).f a ≫ segre R m n =
      zpoint ((prodCover R m n).X a) (segreF R m n a) (X (segreIdx m n a))
        (segreF_unit R m n a) (X_mem_homogeneousSubmodule_one _) Nat.one_pos :=
  ι_glue (prodCover R m n) (fun a => segreF R m n a) (fun a => segreIdx m n a)
    (fun a => segreF_unit R m n a) (fun a b => segre_hX R m n a b)
    (fun a b r => segre_hC R m n a b r) a

/-- The Segre morphism lies over `Spec R`. -/
theorem segre_toSpec :
    segre R m n ≫ toSpec (segreDim m n) R =
      pullback.fst (toSpec m R) (toSpec n R) ≫ toSpec m R := by
  refine (prodCover R m n).hom_ext _ _ ?_
  change ∀ a : Fin (m + 1) × Fin (n + 1), (prodCover R m n).f a ≫ _ = (prodCover R m n).f a ≫ _
  intro a
  rw [← Category.assoc, prodCover_f_segre, zpoint_toSpec, prodCover_f_fst_assoc, chart_toSpec,
    ← toSpecΓ_SpecMap_sharp (chartFst R m n a), Category.assoc, ← Spec.map_comp]
  congr 2
  ext r
  simp [segreF]

/-- A point of `ℙᵐ × ℙⁿ` maps into `D₊(x_{kl})` exactly when its two factors lie in `D₊(x_k)` and
`D₊(x_l)`. -/
theorem mem_segre_preimage (a : Fin (m + 1) × Fin (n + 1)) (x : prodP R m n) :
    x ∈ segre R m n ⁻¹ᵁ
        Proj.basicOpen (homogeneousSubmodule (Fin (segreDim m n + 1)) R) (X (segreIdx m n a)) ↔
      pullback.fst (toSpec m R) (toSpec n R) x ∈ U m R a.1 ∧
        pullback.snd (toSpec m R) (toSpec n R) x ∈ U n R a.2 := by
  obtain ⟨b, y, rfl⟩ := (prodCover R m n).exists_eq x
  change Fin (m + 1) × Fin (n + 1) at b
  rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, prodCover_f_fst, prodCover_f_snd,
    Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
  rw [← Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_preimage, prodCover_f_segre,
    zpoint_preimage _ _ _ (X_mem_homogeneousSubmodule_one _), segreF_X R m n b a.1 a.2,
    Scheme.basicOpen_mul, basicOpen_sharp, basicOpen_sharp, ← chart_preimage_U,
    ← chart_preimage_U]
  rfl

/-- The piece `(k, l)` of the cover is the locus where both factors lie in the charts `k`, `l`. -/
theorem mem_range_prodCover_f (a : Fin (m + 1) × Fin (n + 1)) (x : prodP R m n) :
    x ∈ Set.range ((prodCover R m n).f a) ↔
      pullback.fst (toSpec m R) (toSpec n R) x ∈ U m R a.1 ∧
        pullback.snd (toSpec m R) (toSpec n R) x ∈ U n R a.2 := by
  change x ∈ Set.range (pullback.map (chart a.1 ≫ toSpec m R) (chart a.2 ≫ toSpec n R)
      (toSpec m R) (toSpec n R) (chart a.1) (chart a.2) (𝟙 _) (Category.comp_id _)
      (Category.comp_id _)) ↔ _
  rw [Scheme.Pullback.range_map]
  simp only [Set.mem_inter_iff, Set.mem_preimage]
  rw [← opensRange_chart (R := R) a.1, ← opensRange_chart (R := R) a.2]
  rfl

/-- The pieces of the cover are open immersions. -/
instance isOpenImmersion_prodCover_f (a : Fin (m + 1) × Fin (n + 1)) :
    IsOpenImmersion ((prodCover R m n).f a) :=
  (prodCover R m n).map_prop a

/-- The preimage of `D₊(x_{(k, l)})` under the Segre morphism is the piece `(k, l)`. -/
theorem segre_preimage (a : Fin (m + 1) × Fin (n + 1)) :
    segre R m n ⁻¹ᵁ
        Proj.basicOpen (homogeneousSubmodule (Fin (segreDim m n + 1)) R) (X (segreIdx m n a)) =
      ((prodCover R m n).f a).opensRange := by
  ext x
  exact (mem_segre_preimage R m n a x).trans (mem_range_prodCover_f R m n a x).symm

/-- On the piece `D₊(x_k) × D₊(x_l)`, the Segre chart map is onto the coordinate ring. -/
theorem awayEvalOf_segre_surjective (a : Fin (m + 1) × Fin (n + 1)) :
    Function.Surjective
      (awayEvalOf (segreF R m n a) (X (segreIdx m n a)) (segreF_unit R m n a)) := by
  set φ := awayEvalOf (segreF R m n a) (X (segreIdx m n a)) (segreF_unit R m n a)
  have hdeg := X_mem_homogeneousSubmodule_one (R := R) (segreIdx m n a)
  have hX : ∀ x, segreF R m n a (X x) ∈ φ.range := fun x =>
    ⟨Away.mk _ hdeg 1 (X x) (by rw [smul_eq_mul, mul_one]; exact X_mem_homogeneousSubmodule_one x),
      awayEvalOf_mk_of_eq_one _ _ (segreF_X_self R m n a) _ _ _ _⟩
  have hC : ∀ r, segreF R m n a (C r) ∈ φ.range := fun r =>
    ⟨_, awayEvalOf_fromZero _ _ _ r⟩
  have hα : ∀ p, sharp (chartFst R m n a) p ∈ φ.range := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C r => simpa [segreF] using hC r
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | mul_X p k hp =>
      rw [map_mul]
      refine mul_mem hp ?_
      have := hX (pairEquiv m n (a.1.succAbove k, a.2))
      rwa [segreF_X, dehomogenize_X_succAbove, dehomogenize_X_self (n := n) (R := R) a.2,
        map_one, mul_one] at this
  have hβ : ∀ p, sharp (chartSnd R m n a) p ∈ φ.range := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C r =>
      have e : sharp (chartSnd R m n a) (C r) = sharp (chartFst R m n a) (C r) := by
        have h : chartFst R m n a ≫
              Spec.map (CommRingCat.ofHom (C : R →+* MvPolynomial (Fin m) R)) =
            chartSnd R m n a ≫
              Spec.map (CommRingCat.ofHom (C : R →+* MvPolynomial (Fin n) R)) := by
          calc chartFst R m n a ≫ Spec.map (CommRingCat.ofHom C) =
                chartFst R m n a ≫ chart a.1 ≫ toSpec m R := by
                rw [chart_toSpec]
            _ = chartSnd R m n a ≫ chart a.2 ≫ toSpec n R := by
                exact pullback.condition (f := chart (R := R) a.1 ≫ toSpec m R)
                    (g := chart a.2 ≫ toSpec n R)
            _ = chartSnd R m n a ≫ Spec.map (CommRingCat.ofHom C) := by rw [chart_toSpec]
        have := congr(sharp $h)
        rw [sharp_comp_SpecMap, sharp_comp_SpecMap] at this
        exact (congr($this r)).symm
      rw [e]; simpa [segreF] using hC r
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | mul_X p k hp =>
      rw [map_mul]
      refine mul_mem hp ?_
      have := hX (pairEquiv m n (a.1, a.2.succAbove k))
      rwa [segreF_X, dehomogenize_X_succAbove, dehomogenize_X_self (n := m) (R := R) a.1,
        map_one, one_mul] at this
  have hpush := isPushout_appTop_of_isPullback (IsPullback.of_hasPullback
    (chart (R := R) a.1 ≫ toSpec m R) (chart a.2 ≫ toSpec n R))
  have hclos := HodgeLadder.ComplexPointProd.closure_range_union_eq_top hpush
  intro z
  have hz : z ∈ Subring.closure (Set.range (pullback.fst (chart (R := R) a.1 ≫ toSpec m R)
      (chart a.2 ≫ toSpec n R)).appTop ∪ Set.range (pullback.snd (chart (R := R) a.1 ≫
      toSpec m R) (chart a.2 ≫ toSpec n R)).appTop) := hclos ▸ Subring.mem_top z
  refine RingHom.mem_range.mp ((Subring.closure_le (t := φ.range)).mpr ?_ hz)
  rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩)
  · have := hα ((Scheme.ΓSpecIso _).hom t)
    simp [sharp] at this
    exact this
  · have := hβ ((Scheme.ΓSpecIso _).hom t)
    simp [sharp] at this
    exact this

/-- **The Segre morphism is a closed immersion.** -/
theorem isClosedImmersion_segre : IsClosedImmersion (segre R m n) := by
  apply IsZariskiLocalAtTarget.of_iSup_eq_top (U := U (segreDim m n) R) (iSup_U (segreDim m n) R)
  intro x
  obtain ⟨a, rfl⟩ := (pairEquiv m n).surjective x
  have hD : U (segreDim m n) R (pairEquiv m n a) =
      Proj.basicOpen (homogeneousSubmodule (Fin (segreDim m n + 1)) R) (X (segreIdx m n a)) :=
    rfl
  have hrange : Set.range ((prodCover R m n).f a) =
      Set.range (segre R m n ⁻¹ᵁ U (segreDim m n) R (pairEquiv m n a)).ι := by
    rw [Scheme.Opens.range_ι, hD, segre_preimage]
    rfl
  let e := IsOpenImmersion.isoOfRangeEq ((prodCover R m n).f a)
    (segre R m n ⁻¹ᵁ U (segreDim m n) R (pairEquiv m n a)).ι hrange
  have key : e.hom ≫ segre R m n ∣_ U (segreDim m n) R (pairEquiv m n a) =
      ((prodCover R m n).X a).toSpecΓ ≫
        Spec.map (CommRingCat.ofHom
          (awayEvalOf (segreF R m n a) (X (segreIdx m n a)) (segreF_unit R m n a))) ≫
          (Proj.basicOpenIsoSpec (homogeneousSubmodule (Fin (segreDim m n + 1)) R)
            (X (segreIdx m n a)) (X_mem_homogeneousSubmodule_one _) Nat.one_pos).inv := by
    refine (cancel_mono (U (segreDim m n) R (pairEquiv m n a)).ι).mp ?_
    simp only [Category.assoc, morphismRestrict_ι, IsOpenImmersion.isoOfRangeEq_hom_fac_assoc, e]
    rw [prodCover_f_segre, zpoint, point, Proj.awayι]
    rfl
  rw [← MorphismProperty.cancel_left_of_respectsIso @IsClosedImmersion e.hom, key]
  have : IsAffine ((prodCover R m n).X a) := IsAffine.of_isPullback (IsPullback.of_hasPullback
    (chart (R := R) a.1 ≫ toSpec m R) (chart a.2 ≫ toSpec n R))
  have h1 : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (awayEvalOf (segreF R m n a) (X (segreIdx m n a)) (segreF_unit R m n a)))) :=
    IsClosedImmersion.spec_of_surjective _ (awayEvalOf_segre_surjective R m n a)
  have : IsIso ((prodCover R m n).X a).toSpecΓ := IsAffine.affine
  have h2 : IsClosedImmersion (Proj.basicOpenIsoSpec
      (homogeneousSubmodule (Fin (segreDim m n + 1)) R)
      (X (segreIdx m n a)) (X_mem_homogeneousSubmodule_one _) Nat.one_pos).inv := inferInstance
  exact @IsClosedImmersion.comp _ _ _ _ _ inferInstance (@IsClosedImmersion.comp _ _ _ _ _ h1 h2)

/-- The general Segre morphism at `m = n = 1` is the checked `ℙ¹ × ℙ¹ ⟶ ℙ³` of
`HodgeLadder.General.Segre`. -/
theorem segre_one_one : segre R 1 1 = HodgeLadder.Segre.segre R := rfl

/-! ### Products of projective objects over `Spec ℂ` -/

section Projective

open HodgeLadder.Tests

/-- The inverse of `okaIsoSpace` lies over `Spec ℂ`: followed by Oka's structure morphism it is
upstream's. -/
theorem okaIsoSpace_inv_toSpec (d : ℕ) :
    (okaIsoSpace d).inv ≫ toSpec d ℂ = ProjectiveSpace.toBase (Fin (d + 1)) (Spec ↧ℂ) := by
  rw [Iso.inv_comp_eq]; exact (okaIsoSpace_hom_toBase d).symm

/-- A projective presentation of `X`, followed by `okaIsoSpace`, lies over `Spec ℂ` through
Oka's structure morphism. -/
theorem presentation_oka_w {X : Over (Spec ↧ℂ)} (P : ProjectiveSpace.Presentation X.hom) :
    X.hom = (P.immersion ≫ (okaIsoSpace _).inv) ≫ toSpec _ ℂ := by
  rw [Category.assoc, okaIsoSpace_inv_toSpec, P.immersion_toBase]

variable {X Y : Over (Spec ↧ℂ)}

/-- The closed immersion `X × Y ⟶ ℙᵈ ×_ℂ ℙᵉ` (into Oka's projective spaces) built from
projective presentations of `X` and `Y`. -/
def prodImmersion (P : ProjectiveSpace.Presentation X.hom)
    (Q : ProjectiveSpace.Presentation Y.hom) :
    (X ⨯ Y).left ⟶ prodP ℂ P.ambientDimension Q.ambientDimension :=
  (Over.prodLeftIsoPullback X Y).hom ≫
    pullback.map X.hom Y.hom (toSpec _ ℂ) (toSpec _ ℂ)
      (P.immersion ≫ (okaIsoSpace _).inv) (Q.immersion ≫ (okaIsoSpace _).inv) (𝟙 _)
      ((Category.comp_id _).trans (presentation_oka_w P))
      ((Category.comp_id _).trans (presentation_oka_w Q))

/-- `prodImmersion` is a closed immersion: closed immersions are stable under base change and
composition (Mathlib's `MorphismProperty.pullbackMap`). -/
theorem isClosedImmersion_prodImmersion (P : ProjectiveSpace.Presentation X.hom)
    (Q : ProjectiveSpace.Presentation Y.hom) : IsClosedImmersion (prodImmersion P Q) := by
  have := P.isClosedImmersion
  have := Q.isClosedImmersion
  -- Not found by `inferInstance` at the pin: the parent projection of Mathlib's
  -- `IsMultiplicative @IsClosedImmersion` fails to unify under the default
  -- `backward.isDefEq.respectTransparency.types`, which Mathlib's own `IsClosedImmersion.comp`
  -- sets to false.
  have : MorphismProperty.IsStableUnderComposition @IsClosedImmersion.{0} :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have h := MorphismProperty.pullbackMap (P := @IsClosedImmersion)
    (inferInstance : IsClosedImmersion (P.immersion ≫ (okaIsoSpace _).inv))
    (inferInstance : IsClosedImmersion (Q.immersion ≫ (okaIsoSpace _).inv))
    (presentation_oka_w P) (presentation_oka_w Q)
  unfold prodImmersion
  infer_instance

/-- `prodImmersion` lies over `Spec ℂ`. -/
theorem prodImmersion_fst (P : ProjectiveSpace.Presentation X.hom)
    (Q : ProjectiveSpace.Presentation Y.hom) :
    prodImmersion P Q ≫ pullback.fst _ _ ≫ toSpec _ ℂ = (X ⨯ Y).hom := by
  rw [prodImmersion, Category.assoc, pullback.lift_fst_assoc, Category.assoc, Category.assoc,
    okaIsoSpace_inv_toSpec, P.immersion_toBase, Over.prodLeftIsoPullback_hom_fst_assoc]
  exact Over.w (prod.fst : X ⨯ Y ⟶ X)

/-- The projective presentation of `X × Y`: `prodImmersion` followed by the Segre embedding
`ℙᵈ × ℙᵉ ⟶ ℙ^{de+d+e}` and `HodgeLadder.Tests.okaIsoSpace`. -/
def prodPresentation (P : ProjectiveSpace.Presentation X.hom)
    (Q : ProjectiveSpace.Presentation Y.hom) : ProjectiveSpace.Presentation (X ⨯ Y).hom :=
  have := isClosedImmersion_prodImmersion P Q
  have := isClosedImmersion_segre ℂ P.ambientDimension Q.ambientDimension
  { ambientDimension := segreDim P.ambientDimension Q.ambientDimension
    immersion := prodImmersion P Q ≫ segre ℂ _ _ ≫ (okaIsoSpace _).hom
    immersion_toBase := by
      rw [Category.assoc, Category.assoc,
        show ProjectiveSpace.toBase (Fin (segreDim P.ambientDimension Q.ambientDimension + 1))
            (Spec ↧ℂ) = (projectiveSpace _).hom from rfl,
        okaIsoSpace_hom_toBase, segre_toSpec, prodImmersion_fst] }

/-- **Rung `segre-general`.** The product in `Over (Spec ℂ)` of two projective objects is
projective, through the Segre embedding. The instance matches the categorical product `X ⨯ Y`;
it is not found for Mathlib's `X ⊗ Y` (`CartesianMonoidalCategory (Over S)`), which is not defeq
to `X ⨯ Y` (conventions row "Complex points of a product and product charts"). -/
instance isProjective_prod [IsProjective X.hom] [IsProjective Y.hom] :
    IsProjective (X ⨯ Y).hom :=
  ⟨⟨prodPresentation (IsProjective.nonempty_presentation (f := X.hom)).some
    (IsProjective.nonempty_presentation (f := Y.hom)).some⟩⟩

end Projective

/-! ### Tests -/

/-- ℙ¹ × ℙ² over `ℂ` is projective (the instance `isProjective_prod`). -/
theorem isProjective_p1p2 :
    IsProjective (Tests.projectiveSpace 1 ⨯ Tests.projectiveSpace 2).hom :=
  inferInstance

/-- The affine line over `ℂ` is not projective in upstream's sense: a projective morphism is
proper (upstream's `IsProjective.isProper`), a proper affine morphism is finite, and `ℂ[X]` is
not a finite `ℂ`-module. A non-vacuity check on `IsProjective`. -/
theorem not_isProjective_affineLine :
    ¬ IsProjective (Spec.map (CommRingCat.ofHom (algebraMap ℂ (Polynomial ℂ)))) := by
  intro _
  have hf : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap ℂ (Polynomial ℂ)))) :=
    IsFinite.iff_isProper_and_isAffineHom.mpr ⟨inferInstance, inferInstance⟩
  rw [IsFinite.SpecMap_iff] at hf
  exact Polynomial.not_finite (RingHom.finite_algebraMap.mp hf)

end HodgeLadder.Segre.General
