module

public import LefschetzPort.Oka.AlgebraicGeometry.ProjectiveSpace.Basic
public import HodgeLadder.General.ComplexPointProd
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.Affine
public import Mathlib.AlgebraicGeometry.PullbackCarrier

/-!
# Morphisms to projective space from local coordinates, and the Segre embedding

For a scheme `Z` and a ring map `F : R[x₀, …, x_N] → Γ(Z, ⊤)` sending some `xᵢ` to a unit,
`zpoint Z F (xᵢ)` is the morphism `Z ⟶ ℙₒ(N; R)` with homogeneous coordinates `F(x₀), …, F(x_N)`,
read in the chart `D₊(xᵢ)` (Oka's `ℙₒ(N; R) = Proj R[x₀, …, x_N]`). It does not depend on the
chart (`point_eq_point`) or on a rescaling of the coordinates by a unit (`zpoint_eq_of_smul`), and
two such points that agree have proportional coordinates (`exists_unit_of_zpoint_eq`). Local
coordinates on an open cover that agree up to units on overlaps glue (`glue`).

The Segre morphism `segre R : ℙ¹ ×_R ℙ¹ ⟶ ℙ³` is glued from the four products of standard charts,
with `x_{(k, l)} = aₖ bₗ` on `D₊(a_i) × D₊(b_j)`; it lies over `Spec R` (`segre_toSpec`) and is a
closed immersion (`isClosedImmersion_segre`): the preimage of `D₊(x_{(k, l)})` is the piece
`(k, l)`, and there the map is `Spec` of a surjection, since the coordinate ring of a product of
affine charts is generated by the two factors.

## Main definitions

* `HodgeLadder.Segre.awayEvalOf`, `point`, `zpoint`, `glue`, `sharp`
* `HodgeLadder.Segre.prodP1`, `prodCover`, `pairEquiv`, `segreF`, `segre`

## Main results

* `HodgeLadder.Segre.point_eq_point`, `zpoint_eq_of_smul`, `exists_unit_of_zpoint_eq`,
  `comp_chart`, `ι_glue`
* `HodgeLadder.Segre.segre_toSpec`, `segre_preimage`, `isClosedImmersion_segre`
-/

@[expose] public noncomputable section

open CategoryTheory Limits AlgebraicGeometry MvPolynomial HomogeneousLocalization
open scoped AlgebraicGeometry.ProjectiveSpace

namespace HodgeLadder.Segre

/-- Scaling the values of the variables by `c` scales a homogeneous polynomial of degree `n` by
`c ^ n`. -/
theorem eval₂_mul_of_isHomogeneous {σ R S : Type*} [Fintype σ] [CommSemiring R] [CommSemiring S]
    (φ : R →+* S) (v : σ → S) (c : S) {n : ℕ} {a : MvPolynomial σ R} (ha : a.IsHomogeneous n) :
    eval₂ φ (fun k => c * v k) a = c ^ n * eval₂ φ v a := by
  rw [eval₂_eq', eval₂_eq', Finset.mul_sum]
  refine Finset.sum_congr rfl fun d hd => ?_
  have hdeg := ha (mem_support_iff.mp hd)
  simp only [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]
  have : ∑ i, d i = n := by
    rw [← hdeg, Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp)]
    simp
  rw [this]; ring


variable {N : ℕ} {R : Type} [CommRing R] {S : Type} [CommRing S]

local notation "𝒜" => homogeneousSubmodule (Fin (N + 1)) R

/-- Evaluation `A_(f) → S` of the degree-zero localization through `F : A → S`, for `F f` a
unit. -/
noncomputable def awayEvalOf (F : MvPolynomial (Fin (N + 1)) R →+* S)
    (f : MvPolynomial (Fin (N + 1)) R) (hf : IsUnit (F f)) : Away 𝒜 f →+* S :=
  (Localization.awayLift F f hf).comp (algebraMap (Away 𝒜 f) (Localization.Away f))

/-- `awayEvalOf` on `a / fⁿ`. -/
theorem awayEvalOf_mk (F : MvPolynomial (Fin (N + 1)) R →+* S)
    {f : MvPolynomial (Fin (N + 1)) R} (hf : IsUnit (F f)) {d : ℕ} (hd : f ∈ 𝒜 d) (n : ℕ)
    (a : MvPolynomial (Fin (N + 1)) R) (ha : a ∈ 𝒜 (n • d)) :
    awayEvalOf F f hf (Away.mk 𝒜 hd n a ha) = F a * ((hf.unit⁻¹ : Sˣ) : S) ^ n := by
  have h : F f * ((hf.unit⁻¹ : Sˣ) : S) = 1 := hf.mul_val_inv
  simp only [awayEvalOf, RingHom.coe_comp, Function.comp_apply,
    HomogeneousLocalization.algebraMap_apply, Away.val_mk]
  convert Localization.awayLift_mk F f a _ h n

/-- `awayEvalOf` on `a / fⁿ` when `F f = 1`. -/
theorem awayEvalOf_mk_of_eq_one (F : MvPolynomial (Fin (N + 1)) R →+* S)
    {f : MvPolynomial (Fin (N + 1)) R} (hf : IsUnit (F f)) (h1 : F f = 1) {d : ℕ}
    (hd : f ∈ 𝒜 d) (n : ℕ) (a : MvPolynomial (Fin (N + 1)) R) (ha : a ∈ 𝒜 (n • d)) :
    awayEvalOf F f hf (Away.mk 𝒜 hd n a ha) = F a := by
  have hu : hf.unit = 1 := Units.ext (by simp [h1])
  rw [awayEvalOf_mk, hu, inv_one, Units.val_one, one_pow, mul_one]

/-- `awayEvalOf` on the image of a constant. -/
theorem awayEvalOf_fromZero (F : MvPolynomial (Fin (N + 1)) R →+* S)
    (f : MvPolynomial (Fin (N + 1)) R) (hf : IsUnit (F f)) (r : R) :
    awayEvalOf F f hf (fromZeroRingHom 𝒜 (Submonoid.powers f) (algebraMap R (𝒜 0) r)) =
      F (C r) := by
  have h : val ((fromZeroRingHom 𝒜 (Submonoid.powers f)) ((algebraMap R ↥(𝒜 0)) r)) =
      algebraMap (MvPolynomial (Fin (N + 1)) R) (Localization.Away f) (C r) := by
    rw [← Localization.mk_one_eq_algebraMap]
    rfl
  simp only [awayEvalOf, RingHom.coe_comp, Function.comp_apply,
    HomogeneousLocalization.algebraMap_apply]
  rw [h]
  exact IsLocalization.lift_eq _ _

/-- `awayEvalOf` is compatible with `awayMap` along `x = f * g`. -/
theorem awayEvalOf_comp_awayMap (F : MvPolynomial (Fin (N + 1)) R →+* S)
    {f g x : MvPolynomial (Fin (N + 1)) R} {e : ℕ} (hg : g ∈ 𝒜 e) (hx : x = f * g)
    (hxu : IsUnit (F x)) (hf : IsUnit (F f)) :
    (awayEvalOf F x hxu).comp (awayMap 𝒜 hg hx) = awayEvalOf F f hf := by
  ext z
  simp only [awayEvalOf, RingHom.coe_comp, Function.comp_apply,
    HomogeneousLocalization.algebraMap_apply, val_awayMap]
  rw [← RingHom.comp_apply]
  congr 1
  apply IsLocalization.ringHom_ext (Submonoid.powers f)
  ext a
  · simp [Localization.awayLift, IsLocalization.Away.lift]
  · simp [Localization.awayLift, IsLocalization.Away.lift]


/-- The `S`-point of `ℙₒ(N; R)` with homogeneous coordinates `F`, read in the chart `D₊(f)`. -/
noncomputable def point (F : MvPolynomial (Fin (N + 1)) R →+* S)
    (f : MvPolynomial (Fin (N + 1)) R) (hf : IsUnit (F f)) {m : ℕ} (hm : f ∈ 𝒜 m) (hm0 : 0 < m) :
    Spec (.of S) ⟶ ℙₒ(N; R) :=
  Spec.map (CommRingCat.ofHom (awayEvalOf F f hf)) ≫ Proj.awayι 𝒜 f hm hm0

/-- `point` does not depend on the degree recorded for `f`. -/
theorem point_congr_deg (F : MvPolynomial (Fin (N + 1)) R →+* S)
    {f : MvPolynomial (Fin (N + 1)) R} (hf : IsUnit (F f)) {m m' : ℕ} (h : m = m')
    (hm : f ∈ 𝒜 m) (hm0 : 0 < m) (hm' : f ∈ 𝒜 m') (hm0' : 0 < m') :
    point F f hf hm hm0 = point F f hf hm' hm0' := by
  subst h; rfl

/-- Passing to a smaller chart `D₊(f g)` does not change the point. -/
theorem point_eq_mul (F : MvPolynomial (Fin (N + 1)) R →+* S)
    {f g x : MvPolynomial (Fin (N + 1)) R} {m e : ℕ} (hf : IsUnit (F f)) (hm : f ∈ 𝒜 m)
    (hm0 : 0 < m) (hg : g ∈ 𝒜 e) (hx : x = f * g) (hxu : IsUnit (F x)) :
    point F f hf hm hm0 = point F x hxu (hx ▸ SetLike.mul_mem_graded hm hg)
      (hm0.trans_le (m.le_add_right e)) := by
  rw [point, point, ← awayEvalOf_comp_awayMap F hg hx hxu hf, CommRingCat.ofHom_comp,
    Spec.map_comp, Category.assoc, Proj.SpecMap_awayMap_awayι]

/-- The point does not depend on the chart. -/
theorem point_eq_point (F : MvPolynomial (Fin (N + 1)) R →+* S)
    {f g : MvPolynomial (Fin (N + 1)) R} {m e : ℕ} (hf : IsUnit (F f)) (hm : f ∈ 𝒜 m)
    (hm0 : 0 < m) (hg : IsUnit (F g)) (he : g ∈ 𝒜 e) (he0 : 0 < e) :
    point F f hf hm hm0 = point F g hg he he0 := by
  have hxu : IsUnit (F (f * g)) := by rw [map_mul]; exact hf.mul hg
  rw [point_eq_mul F hf hm hm0 he rfl hxu,
    point_eq_mul F hg he he0 hm (mul_comm f g) hxu]
  exact point_congr_deg F hxu (Nat.add_comm m e) _ _ _ _

/-- Homogeneous coordinates scaled by a unit `c` give the same point. -/
theorem awayEvalOf_eq_of_smul (F F' : MvPolynomial (Fin (N + 1)) R →+* S) (c : Sˣ)
    (hF : ∀ n, ∀ a ∈ 𝒜 n, F' a = (c : S) ^ n * F a)
    {f : MvPolynomial (Fin (N + 1)) R} {m : ℕ} (hm : f ∈ 𝒜 m) (hf : IsUnit (F f))
    (hf' : IsUnit (F' f)) :
    awayEvalOf F' f hf' = awayEvalOf F f hf := by
  ext z
  obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒜 hm z
  rw [awayEvalOf_mk, awayEvalOf_mk, hF _ a ha]
  have h1 : F' f = (c : S) ^ m * F f := hF m f hm
  have h2 : hf'.unit = c ^ m * hf.unit := Units.ext (by simp [h1])
  have key : (c : S) ^ (n • m) * (((c ^ m * hf.unit)⁻¹ : Sˣ) : S) ^ n =
      ((hf.unit⁻¹ : Sˣ) : S) ^ n := by
    rw [← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val,
      ← Units.val_mul]
    congr 1
    rw [smul_eq_mul, mul_inv, mul_pow, ← mul_assoc, inv_pow, ← pow_mul, mul_comm m n,
      mul_inv_cancel, one_mul]
  rw [h2, ← key]
  ring


/-- A section whose basic open is everything is a unit. -/
theorem isUnit_of_basicOpen_eq_top {Z : Scheme} (r : Γ(Z, ⊤)) (h : Z.basicOpen r = ⊤) :
    IsUnit r :=
  Z.toRingedSpace.isUnit_of_isUnit_germ ⊤ r fun x _ =>
    (Z.mem_basicOpen_top r x).mp (by rw [h]; trivial)

/-- A ring map into `Γ(Z, ⊤)` is recovered from the morphism `Z ⟶ Spec A` it induces. -/
theorem ringHom_eq_of_toSpecΓ {Z : Scheme} {A : CommRingCat} (φ ψ : A ⟶ Γ(Z, ⊤))
    (h : Z.toSpecΓ ≫ Spec.map φ = Z.toSpecΓ ≫ Spec.map ψ) : φ = ψ := by
  have key : ∀ χ : A ⟶ Γ(Z, ⊤),
      (Z.toSpecΓ ≫ Spec.map χ).appTop = (Scheme.ΓSpecIso A).hom ≫ χ := by
    intro χ
    rw [Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop, Scheme.ΓSpecIso_naturality]
  have := key φ
  rw [h, key ψ] at this
  simpa using this.symm

variable (Z : Scheme)

/-- The morphism `Z ⟶ ℙₒ(N; R)` with homogeneous coordinates `F : A → Γ(Z, ⊤)`, read in the
chart `D₊(f)`. -/
noncomputable def zpoint (F : MvPolynomial (Fin (N + 1)) R →+* Γ(Z, ⊤))
    (f : MvPolynomial (Fin (N + 1)) R) (hf : IsUnit (F f)) {m : ℕ} (hm : f ∈ 𝒜 m)
    (hm0 : 0 < m) : Z ⟶ ℙₒ(N; R) :=
  Z.toSpecΓ ≫ point F f hf hm hm0

variable {Z}

/-- Precomposing a `Z`-point pulls its coordinates back. -/
theorem comp_zpoint {Z' : Scheme} (g : Z' ⟶ Z) (F : MvPolynomial (Fin (N + 1)) R →+* Γ(Z, ⊤))
    (f : MvPolynomial (Fin (N + 1)) R) (hf : IsUnit (F f)) {m : ℕ} (hm : f ∈ 𝒜 m)
    (hm0 : 0 < m) :
    g ≫ zpoint Z F f hf hm hm0 =
      zpoint Z' (g.appTop.hom.comp F) f (hf.map g.appTop.hom) hm hm0 := by
  rw [zpoint, zpoint, point, point, Scheme.toSpecΓ_naturality_assoc, ← Spec.map_comp_assoc]
  congr 3
  ext z
  simp only [awayEvalOf, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
    Function.comp_apply]
  rw [← RingHom.comp_apply (g.appTop.hom)]
  congr 1
  apply IsLocalization.ringHom_ext (Submonoid.powers f)
  ext a
  · simp [Localization.awayLift, IsLocalization.Away.lift]
  · simp [Localization.awayLift, IsLocalization.Away.lift]

/-- Preimage of a standard open under `zpoint`, in degree one. -/
theorem zpoint_preimage (F : MvPolynomial (Fin (N + 1)) R →+* Γ(Z, ⊤))
    {f g : MvPolynomial (Fin (N + 1)) R} (hf : IsUnit (F f)) (hm : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) :
    zpoint Z F f hf hm Nat.one_pos ⁻¹ᵁ Proj.basicOpen 𝒜 g = Z.basicOpen (F g) := by
  rw [zpoint, point, Scheme.Hom.comp_preimage, Scheme.Hom.comp_preimage,
    Proj.awayι_preimage_basicOpen 𝒜 hm Nat.one_pos hg Nat.one_pos, SpecMap_preimage_basicOpen,
    Scheme.toSpecΓ_preimage_basicOpen]
  simp only [CommRingCat.hom_ofHom]
  rw [awayEvalOf_mk, pow_one, pow_one, Scheme.basicOpen_mul,
    Scheme.basicOpen_of_isUnit _ (Units.isUnit _), inf_top_eq]


/-- Two `Z`-points of `ℙₒ(N; R)` in standard charts that agree have proportional homogeneous
coordinates. -/
theorem exists_unit_of_zpoint_eq (F G : MvPolynomial (Fin (N + 1)) R →+* Γ(Z, ⊤))
    {i i' : Fin (N + 1)} (hF : IsUnit (F (X i))) (hG : IsUnit (G (X i')))
    (h : zpoint Z F (X i) hF (X_mem_homogeneousSubmodule_one i) Nat.one_pos =
      zpoint Z G (X i') hG (X_mem_homogeneousSubmodule_one i') Nat.one_pos) :
    ∃ c : Γ(Z, ⊤)ˣ, ∀ k, F (X k) = c * G (X k) := by
  have hGi : IsUnit (G (X i)) := by
    apply isUnit_of_basicOpen_eq_top
    have h1 := zpoint_preimage F hF (X_mem_homogeneousSubmodule_one i)
      (X_mem_homogeneousSubmodule_one (R := R) i)
    have h2 := zpoint_preimage G hG (X_mem_homogeneousSubmodule_one i')
      (X_mem_homogeneousSubmodule_one (R := R) i)
    rw [h] at h1
    rw [← h2, h1, Scheme.basicOpen_of_isUnit _ hF]
  have h' : zpoint Z F (X i) hF (X_mem_homogeneousSubmodule_one i) Nat.one_pos =
      zpoint Z G (X i) hGi (X_mem_homogeneousSubmodule_one i) Nat.one_pos := by
    rw [h, zpoint, zpoint, point_eq_point G hG _ _ hGi (X_mem_homogeneousSubmodule_one i)
      Nat.one_pos]
  simp only [zpoint, point] at h'
  have h'' := (cancel_mono (Proj.awayι 𝒜 (X i) (X_mem_homogeneousSubmodule_one i)
    Nat.one_pos)).mp (by simpa only [← Category.assoc] using h')
  have he := ringHom_eq_of_toSpecΓ _ _ h''
  refine ⟨hF.unit * hGi.unit⁻¹, fun k => ?_⟩
  have := congr($(he) (Away.mk 𝒜 (X_mem_homogeneousSubmodule_one i) 1 (X k)
    (by rw [smul_eq_mul, mul_one]; exact X_mem_homogeneousSubmodule_one k)))
  simp only [CommRingCat.hom_ofHom, awayEvalOf_mk, pow_one] at this
  have h3 := congrArg (· * F (X i)) this
  have e1 : ((hF.unit⁻¹ : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) * F (X i) = 1 := hF.val_inv_mul
  rw [mul_assoc, e1, mul_one] at h3
  rw [h3]
  simp only [Units.val_mul, IsUnit.unit_spec]
  ring


/-- Proportional homogeneous coordinates give the same `Z`-point. -/
theorem zpoint_eq_of_smul (F F' : MvPolynomial (Fin (N + 1)) R →+* Γ(Z, ⊤)) (c : Γ(Z, ⊤)ˣ)
    (hX : ∀ k, F' (X k) = c * F (X k)) (hC : ∀ r, F' (C r) = F (C r))
    {i j : Fin (N + 1)} (hi : IsUnit (F (X i))) (hj : IsUnit (F' (X j))) :
    zpoint Z F' (X j) hj (X_mem_homogeneousSubmodule_one j) Nat.one_pos =
      zpoint Z F (X i) hi (X_mem_homogeneousSubmodule_one i) Nat.one_pos := by
  have hF : ∀ n, ∀ a ∈ 𝒜 n, F' a = (c : Γ(Z, ⊤)) ^ n * F a := by
    intro n a ha
    have e1 : F' = eval₂Hom (F.comp C) (fun k => (c : Γ(Z, ⊤)) * F (X k)) :=
      MvPolynomial.ringHom_ext (fun r => by simp [hC]) (fun k => by simp [hX])
    have e2 : F = eval₂Hom (F.comp C) (fun k => F (X k)) :=
      MvPolynomial.ringHom_ext (fun r => by simp) (fun k => by simp)
    rw [e1]
    conv_rhs => rw [e2]
    exact eval₂_mul_of_isHomogeneous _ _ _ ((mem_homogeneousSubmodule _ _).mp ha)
  have hi' : IsUnit (F' (X i)) := by rw [hX]; exact c.isUnit.mul hi
  rw [zpoint, zpoint, point_eq_point F' hj _ _ hi' (X_mem_homogeneousSubmodule_one i)
    Nat.one_pos, point, point,
    awayEvalOf_eq_of_smul F F' c hF (X_mem_homogeneousSubmodule_one i) hi hi']


section Glue

variable (𝒰 : Z.OpenCover) (F : ∀ a, MvPolynomial (Fin (N + 1)) R →+* Γ(𝒰.X a, ⊤))
  (ι : 𝒰.I₀ → Fin (N + 1)) (hι : ∀ a, IsUnit (F a (X (ι a))))
  (hX : ∀ a b, ∃ c : Γ(pullback (𝒰.f a) (𝒰.f b), ⊤)ˣ, ∀ k,
    (pullback.fst (𝒰.f a) (𝒰.f b)).appTop (F a (X k)) =
      c * (pullback.snd (𝒰.f a) (𝒰.f b)).appTop (F b (X k)))
  (hC : ∀ a b r, (pullback.fst (𝒰.f a) (𝒰.f b)).appTop (F a (C r)) =
      (pullback.snd (𝒰.f a) (𝒰.f b)).appTop (F b (C r)))

/-- The morphism `Z ⟶ ℙₒ(N; R)` glued from local homogeneous coordinates that agree up to
units on overlaps. -/
noncomputable def glue : Z ⟶ ℙₒ(N; R) :=
  𝒰.glueMorphisms
    (fun a => zpoint (𝒰.X a) (F a) (X (ι a)) (hι a) (X_mem_homogeneousSubmodule_one _)
      Nat.one_pos)
    (fun a b => by
      rw [comp_zpoint, comp_zpoint]
      obtain ⟨c, hc⟩ := hX a b
      exact zpoint_eq_of_smul _ _ c hc (hC a b) _ _)

/-- On each piece of the cover, `glue` is the local `Z`-point. -/
theorem ι_glue (a : 𝒰.I₀) :
    𝒰.f a ≫ glue 𝒰 F ι hι hX hC =
      zpoint (𝒰.X a) (F a) (X (ι a)) (hι a) (X_mem_homogeneousSubmodule_one _) Nat.one_pos :=
  𝒰.ι_glueMorphisms _ _ a

end Glue


section Sharp

/-- The ring map `A → Γ(Z, ⊤)` of a morphism `Z ⟶ Spec A`. -/
noncomputable def sharp {Z : Scheme} {A : CommRingCat} (α : Z ⟶ Spec A) : A →+* Γ(Z, ⊤) :=
  ((Scheme.ΓSpecIso A).inv ≫ α.appTop).hom

/-- A morphism `Z ⟶ Spec A` factors through `Spec Γ(Z, ⊤)` by its ring map. -/
theorem toSpecΓ_SpecMap_sharp {Z : Scheme} {A : CommRingCat} (α : Z ⟶ Spec A) :
    Z.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (sharp α)) = α := by
  have h := Scheme.toSpecΓ_naturality α
  rw [← SpecMap_ΓSpecIso_hom] at h
  rw [sharp, CommRingCat.ofHom_hom, Spec.map_comp, ← Category.assoc, ← h, Category.assoc,
    ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
  exact Category.comp_id α

/-- `sharp` of a composite. -/
theorem sharp_comp {Z Z' : Scheme} {A : CommRingCat} (g : Z' ⟶ Z) (α : Z ⟶ Spec A) :
    sharp (g ≫ α) = g.appTop.hom.comp (sharp α) := by
  simp only [sharp, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
  rfl

/-- `sharp` of a composite with `Spec.map`. -/
theorem sharp_comp_SpecMap {Z : Scheme} {A B : CommRingCat} (α : Z ⟶ Spec A) (φ : B ⟶ A) :
    sharp (α ≫ Spec.map φ) = (sharp α).comp φ.hom := by
  simp only [sharp, Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
    CommRingCat.hom_comp]
  rfl

/-- The basic open of a pulled-back function is the preimage of its basic open. -/
theorem basicOpen_sharp {Z : Scheme} {A : CommRingCat} (α : Z ⟶ Spec A) (p : A) :
    Z.basicOpen (sharp α p) = α ⁻¹ᵁ PrimeSpectrum.basicOpen p := by
  rw [← basicOpen_eq_of_affine, Scheme.preimage_basicOpen_top]
  rfl

end Sharp

/-- `awayEvalOf` composed with a ring map. -/
theorem comp_awayEvalOf {S' : Type} [CommRing S'] (g : S →+* S')
    (F : MvPolynomial (Fin (N + 1)) R →+* S) (f : MvPolynomial (Fin (N + 1)) R)
    (hf : IsUnit (F f)) :
    g.comp (awayEvalOf F f hf) = awayEvalOf (g.comp F) f (hf.map g) := by
  ext z
  simp only [awayEvalOf, RingHom.coe_comp, Function.comp_apply]
  rw [← RingHom.comp_apply g]
  congr 1
  apply IsLocalization.ringHom_ext (Submonoid.powers f)
  ext a
  · simp [Localization.awayLift, IsLocalization.Away.lift]
  · simp [Localization.awayLift, IsLocalization.Away.lift]

/-- A `Z`-point lies over `Spec R` through the constants of its coordinates. -/
theorem zpoint_toSpec {Z : Scheme} (F : MvPolynomial (Fin (N + 1)) R →+* Γ(Z, ⊤))
    (i : Fin (N + 1)) (hi : IsUnit (F (X i))) :
    zpoint Z F (X i) hi (X_mem_homogeneousSubmodule_one i) Nat.one_pos ≫
        AlgebraicGeometry.ProjectiveSpace.toSpec N R =
      Z.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (F.comp C)) := by
  rw [zpoint, point, AlgebraicGeometry.ProjectiveSpace.toSpec, Category.assoc, Category.assoc,
    Proj.awayι_toSpecZero_assoc, ← Spec.map_comp, ← Spec.map_comp]
  congr 2
  ext r
  simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp, Function.comp_apply,
    awayEvalOf, HomogeneousLocalization.algebraMap_apply]
  have h : val ((fromZeroRingHom 𝒜 (Submonoid.powers (X i))) ((algebraMap R ↥(𝒜 0)) r)) =
      algebraMap (MvPolynomial (Fin (N + 1)) R) (Localization.Away (X i)) (C r) := by
    rw [← Localization.mk_one_eq_algebraMap]
    rfl
  rw [h]
  exact IsLocalization.lift_eq _ _

section Chart

open AlgebraicGeometry.ProjectiveSpace

/-- A morphism through the standard chart `i` of `ℙₒ(N; R)` is the `Z`-point with homogeneous
coordinates the dehomogenized variables. -/
theorem comp_chart {Z : Scheme} (α : Z ⟶ Spec (.of (MvPolynomial (Fin N) R))) (i : Fin (N + 1)) :
    α ≫ chart i = zpoint Z ((sharp α).comp (dehomogenize R i).toRingHom) (X i)
      (by simp) (X_mem_homogeneousSubmodule_one i) Nat.one_pos := by
  have h1 : (awayXEquiv R i).symm.toRingHom =
      awayEvalOf (dehomogenize R i).toRingHom (X i) (by simp) := by
    ext z
    rw [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, awayXEquiv_symm_apply]
    rfl
  conv_lhs => rw [← toSpecΓ_SpecMap_sharp α]
  rw [chart, zpoint, point, h1, Category.assoc, ← Spec.map_comp_assoc, ← CommRingCat.ofHom_comp,
    comp_awayEvalOf]

/-- Two morphisms through standard charts that agree have proportional coordinates. -/
theorem exists_unit_of_comp_chart_eq {Z : Scheme} (γ δ : Z ⟶ Spec (.of (MvPolynomial (Fin N) R)))
    (i j : Fin (N + 1)) (h : γ ≫ chart i = δ ≫ chart j) :
    ∃ c : Γ(Z, ⊤)ˣ, ∀ k, sharp γ (dehomogenize R i (X k)) =
      c * sharp δ (dehomogenize R j (X k)) := by
  rw [comp_chart, comp_chart] at h
  exact exists_unit_of_zpoint_eq _ _ _ _ h

end Chart


section SegreMap

open AlgebraicGeometry.ProjectiveSpace

variable (R)

/-- `ℙ¹ ×_R ℙ¹`, as the fibre product of Oka's `ℙₒ(1; R)` with itself over `Spec R`. -/
noncomputable abbrev prodP1 : Scheme := pullback (toSpec 1 R) (toSpec 1 R)

/-- The cover of `ℙ¹ × ℙ¹` by the four products of standard charts. -/
noncomputable abbrev prodCover : (prodP1 R).OpenCover :=
  Scheme.Pullback.openCoverOfLeftRight (affineOpenCover 1 R).openCover
    (affineOpenCover 1 R).openCover (toSpec 1 R) (toSpec 1 R)

/-- The indexing of the coordinates of `ℙ³` by pairs. -/
noncomputable def pairEquiv : Fin 2 × Fin 2 ≃ Fin (3 + 1) :=
  finProdFinEquiv.trans (finCongr (by norm_num))

/-- The first chart coordinate on a piece of the cover. -/
noncomputable abbrev chartFst (a : Fin 2 × Fin 2) :
    (prodCover R).X a ⟶ Spec (.of (MvPolynomial (Fin 1) R)) := pullback.fst _ _

/-- The second chart coordinate on a piece of the cover. -/
noncomputable abbrev chartSnd (a : Fin 2 × Fin 2) :
    (prodCover R).X a ⟶ Spec (.of (MvPolynomial (Fin 1) R)) := pullback.snd _ _

/-- The Segre coordinates `x_{kl} = a_k b_l` on a piece of the cover. -/
noncomputable def segreF (a : Fin 2 × Fin 2) :
    MvPolynomial (Fin (3 + 1)) R →+* Γ((prodCover R).X a, ⊤) :=
  eval₂Hom ((sharp (chartFst R a)).comp C) fun m =>
    sharp (chartFst R a) (dehomogenize R a.1 (X ((pairEquiv).symm m).1)) *
      sharp (chartSnd R a) (dehomogenize R a.2 (X ((pairEquiv).symm m).2))

/-- The Segre coordinate `x_{(k, l)}` on a piece is `aₖ bₗ`. -/
theorem segreF_X (a : Fin 2 × Fin 2) (k l : Fin 2) :
    segreF R a (X (pairEquiv (k, l))) =
      sharp (chartFst R a) (dehomogenize R a.1 (X k)) * sharp (chartSnd R a) (dehomogenize R a.2 (X l)) := by
  simp [segreF]

/-- The chart index of a piece of the cover. -/
noncomputable abbrev segreIdx (a : Fin 2 × Fin 2) : Fin (3 + 1) := pairEquiv (a.1, a.2)

/-- The chart coordinate of a piece is a unit there. -/
theorem segreF_unit (a : Fin 2 × Fin 2) : IsUnit (segreF R a (X (segreIdx a))) := by
  rw [segreF_X R a a.1 a.2, dehomogenize_X_self (n := 1) (R := R) a.1,
    dehomogenize_X_self (n := 1) (R := R) a.2, map_one, map_one, mul_one]
  exact isUnit_one

/-- The first projection of a piece is the first chart coordinate followed by the chart. -/
@[reassoc]
theorem prodCover_f_fst (a : Fin 2 × Fin 2) :
    (prodCover R).f a ≫ pullback.fst (toSpec 1 R) (toSpec 1 R) = chartFst R a ≫ chart a.1 := by
  exact pullback.lift_fst _ _ _

/-- The second projection of a piece is the second chart coordinate followed by the chart. -/
@[reassoc]
theorem prodCover_f_snd (a : Fin 2 × Fin 2) :
    (prodCover R).f a ≫ pullback.snd (toSpec 1 R) (toSpec 1 R) = chartSnd R a ≫ chart a.2 := by
  exact pullback.lift_snd _ _ _

/-- On the overlap of two pieces the Segre coordinates agree up to a unit. -/
theorem segre_hX (a b : Fin 2 × Fin 2) :
    ∃ c : Γ(pullback ((prodCover R).f a) ((prodCover R).f b), ⊤)ˣ, ∀ k,
      (pullback.fst ((prodCover R).f a) ((prodCover R).f b)).appTop (segreF R a (X k)) =
        c * (pullback.snd ((prodCover R).f a) ((prodCover R).f b)).appTop (segreF R b (X k)) := by
  have h1 : (pullback.fst ((prodCover R).f a) ((prodCover R).f b) ≫ chartFst R a) ≫ chart a.1 =
      (pullback.snd ((prodCover R).f a) ((prodCover R).f b) ≫ chartFst R b) ≫ chart b.1 := by
    rw [Category.assoc, Category.assoc, ← prodCover_f_fst, ← prodCover_f_fst, pullback.condition_assoc]
  have h2 : (pullback.fst ((prodCover R).f a) ((prodCover R).f b) ≫ chartSnd R a) ≫ chart a.2 =
      (pullback.snd ((prodCover R).f a) ((prodCover R).f b) ≫ chartSnd R b) ≫ chart b.2 := by
    rw [Category.assoc, Category.assoc, ← prodCover_f_snd, ← prodCover_f_snd, pullback.condition_assoc]
  obtain ⟨c₁, hc₁⟩ := exists_unit_of_comp_chart_eq _ _ _ _ h1
  obtain ⟨c₂, hc₂⟩ := exists_unit_of_comp_chart_eq _ _ _ _ h2
  refine ⟨c₁ * c₂, fun m => ?_⟩
  obtain ⟨⟨k, l⟩, rfl⟩ := pairEquiv.surjective m
  rw [segreF_X, segreF_X, map_mul, map_mul]
  have e1 := hc₁ k
  have e2 := hc₂ l
  rw [sharp_comp, sharp_comp] at e1 e2
  simp only [RingHom.comp_apply] at e1 e2
  rw [e1, e2, Units.val_mul]
  ring

/-- On the overlap of two pieces the Segre coordinates have the same constants. -/
theorem segre_hC (a b : Fin 2 × Fin 2) (r : R) :
    (pullback.fst ((prodCover R).f a) ((prodCover R).f b)).appTop (segreF R a (C r)) =
      (pullback.snd ((prodCover R).f a) ((prodCover R).f b)).appTop (segreF R b (C r)) := by
  have h := pullback.condition_assoc (f := (prodCover R).f a) (g := (prodCover R).f b)
    (pullback.fst (toSpec 1 R) (toSpec 1 R) ≫ toSpec 1 R)
  rw [prodCover_f_fst_assoc, prodCover_f_fst_assoc, chart_toSpec, chart_toSpec] at h
  have := congr(sharp $h r)
  simp only [← Category.assoc] at this
  rw [sharp_comp_SpecMap, sharp_comp_SpecMap, sharp_comp, sharp_comp] at this
  simpa [segreF] using this

/-- **The Segre morphism** `ℙ¹ ×_R ℙ¹ ⟶ ℙ³`, `([a₀ : a₁], [b₀ : b₁]) ↦ [aₖ bₗ]`, with the
coordinate `x_{(k, l)}` indexed through `pairEquiv`. -/
noncomputable def segre : prodP1 R ⟶ ℙₒ(3; R) :=
  glue (prodCover R) (fun a => segreF R a) (fun a => segreIdx a) (fun a => segreF_unit R a)
    (fun a b => segre_hX R a b) (fun a b r => segre_hC R a b r)

/-- On each piece, the Segre morphism is the `Z`-point with the Segre coordinates. -/
theorem prodCover_f_segre (a : Fin 2 × Fin 2) :
    (prodCover R).f a ≫ segre R = zpoint ((prodCover R).X a) (segreF R a) (X (segreIdx a))
      (segreF_unit R a) (X_mem_homogeneousSubmodule_one _) Nat.one_pos :=
  ι_glue (prodCover R) (fun a => segreF R a) (fun a => segreIdx a) (fun a => segreF_unit R a)
    (fun a b => segre_hX R a b) (fun a b r => segre_hC R a b r) a

/-- The Segre morphism lies over `Spec R`. -/
theorem segre_toSpec :
    segre R ≫ toSpec 3 R = pullback.fst (toSpec 1 R) (toSpec 1 R) ≫ toSpec 1 R := by
  refine (prodCover R).hom_ext _ _ ?_
  change ∀ a : Fin 2 × Fin 2, (prodCover R).f a ≫ _ = (prodCover R).f a ≫ _
  intro a
  rw [← Category.assoc, prodCover_f_segre, zpoint_toSpec, prodCover_f_fst_assoc, chart_toSpec,
    ← toSpecΓ_SpecMap_sharp (chartFst R a), Category.assoc, ← Spec.map_comp]
  congr 2
  ext r
  simp [segreF]

/-- A point of `ℙ¹ × ℙ¹` maps into `D₊(x_{kl})` exactly when its two factors lie in `D₊(x_k)` and
`D₊(x_l)`. -/
theorem mem_segre_preimage (a : Fin 2 × Fin 2) (x : prodP1 R) :
    x ∈ segre R ⁻¹ᵁ Proj.basicOpen (homogeneousSubmodule (Fin (3 + 1)) R) (X (segreIdx a)) ↔
      pullback.fst (toSpec 1 R) (toSpec 1 R) x ∈ U 1 R a.1 ∧
        pullback.snd (toSpec 1 R) (toSpec 1 R) x ∈ U 1 R a.2 := by
  obtain ⟨b, y, rfl⟩ := (prodCover R).exists_eq x
  change Fin 2 × Fin 2 at b
  rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, prodCover_f_fst, prodCover_f_snd,
    Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
  rw [← Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_preimage, prodCover_f_segre,
    zpoint_preimage _ _ _ (X_mem_homogeneousSubmodule_one _), segreF_X R b a.1 a.2,
    Scheme.basicOpen_mul, basicOpen_sharp, basicOpen_sharp, ← chart_preimage_U,
    ← chart_preimage_U]
  rfl

/-- The piece `(k, l)` of the cover is the locus where both factors lie in the charts `k`, `l`. -/
theorem mem_range_prodCover_f (a : Fin 2 × Fin 2) (x : prodP1 R) :
    x ∈ Set.range ((prodCover R).f a) ↔
      pullback.fst (toSpec 1 R) (toSpec 1 R) x ∈ U 1 R a.1 ∧
        pullback.snd (toSpec 1 R) (toSpec 1 R) x ∈ U 1 R a.2 := by
  change x ∈ Set.range (pullback.map (chart a.1 ≫ toSpec 1 R) (chart a.2 ≫ toSpec 1 R)
      (toSpec 1 R) (toSpec 1 R) (chart a.1) (chart a.2) (𝟙 _) (Category.comp_id _)
      (Category.comp_id _)) ↔ _
  rw [Scheme.Pullback.range_map]
  simp only [Set.mem_inter_iff, Set.mem_preimage]
  rw [← opensRange_chart (R := R) a.1, ← opensRange_chart (R := R) a.2]
  rfl

/-- The pieces of the cover are open immersions. -/
instance (a : Fin 2 × Fin 2) : IsOpenImmersion ((prodCover R).f a) := (prodCover R).map_prop a

/-- The preimage of `D₊(x_{(k, l)})` under the Segre morphism is the piece `(k, l)`. -/
theorem segre_preimage (a : Fin 2 × Fin 2) :
    segre R ⁻¹ᵁ Proj.basicOpen (homogeneousSubmodule (Fin (3 + 1)) R) (X (segreIdx a)) =
      ((prodCover R).f a).opensRange := by
  ext x
  exact (mem_segre_preimage R a x).trans (mem_range_prodCover_f R a x).symm

/-- The chart coordinate of a piece equals `1` there. -/
theorem segreF_X_self (a : Fin 2 × Fin 2) : segreF R a (X (segreIdx a)) = 1 := by
  rw [segreF_X R a a.1 a.2, dehomogenize_X_self (n := 1) (R := R) a.1,
    dehomogenize_X_self (n := 1) (R := R) a.2, map_one, map_one, mul_one]

/-- On the piece `D₊(x_k) × D₊(x_l)`, the Segre chart map is onto the coordinate ring. -/
theorem awayEvalOf_segre_surjective (a : Fin 2 × Fin 2) :
    Function.Surjective (awayEvalOf (segreF R a) (X (segreIdx a)) (segreF_unit R a)) := by
  set φ := awayEvalOf (segreF R a) (X (segreIdx a)) (segreF_unit R a)
  have hdeg := X_mem_homogeneousSubmodule_one (R := R) (segreIdx a)
  have hX : ∀ m, segreF R a (X m) ∈ φ.range := fun m =>
    ⟨Away.mk _ hdeg 1 (X m) (by rw [smul_eq_mul, mul_one]; exact X_mem_homogeneousSubmodule_one m),
      awayEvalOf_mk_of_eq_one _ _ (segreF_X_self R a) _ _ _ _⟩
  have hC : ∀ r, segreF R a (C r) ∈ φ.range := fun r =>
    ⟨_, awayEvalOf_fromZero _ _ _ r⟩
  have hα : ∀ p, sharp (chartFst R a) p ∈ φ.range := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C r => simpa [segreF] using hC r
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | mul_X p k hp =>
      rw [map_mul]
      refine mul_mem hp ?_
      have := hX (pairEquiv (a.1.succAbove k, a.2))
      rwa [segreF_X, dehomogenize_X_succAbove, dehomogenize_X_self (n := 1) (R := R) a.2,
        map_one, mul_one] at this
  have hβ : ∀ p, sharp (chartSnd R a) p ∈ φ.range := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C r =>
      have e : sharp (chartSnd R a) (C r) = sharp (chartFst R a) (C r) := by
        have h : chartFst R a ≫ Spec.map (CommRingCat.ofHom (C : R →+* MvPolynomial (Fin 1) R)) =
            chartSnd R a ≫ Spec.map (CommRingCat.ofHom (C : R →+* MvPolynomial (Fin 1) R)) := by
          calc chartFst R a ≫ Spec.map (CommRingCat.ofHom C) = chartFst R a ≫ chart a.1 ≫ toSpec 1 R := by
                rw [chart_toSpec]
            _ = chartSnd R a ≫ chart a.2 ≫ toSpec 1 R := by
                exact pullback.condition (f := chart (R := R) a.1 ≫ toSpec 1 R)
                    (g := chart a.2 ≫ toSpec 1 R)
            _ = chartSnd R a ≫ Spec.map (CommRingCat.ofHom C) := by rw [chart_toSpec]
        have := congr(sharp $h)
        rw [sharp_comp_SpecMap, sharp_comp_SpecMap] at this
        exact (congr($this r)).symm
      rw [e]; simpa [segreF] using hC r
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | mul_X p k hp =>
      rw [map_mul]
      refine mul_mem hp ?_
      have := hX (pairEquiv (a.1, a.2.succAbove k))
      rwa [segreF_X, dehomogenize_X_succAbove, dehomogenize_X_self (n := 1) (R := R) a.1,
        map_one, one_mul] at this
  have hpush := isPushout_appTop_of_isPullback (IsPullback.of_hasPullback
    (chart (R := R) a.1 ≫ toSpec 1 R) (chart a.2 ≫ toSpec 1 R))
  have hclos := HodgeLadder.ComplexPointProd.closure_range_union_eq_top hpush
  intro z
  have hz : z ∈ Subring.closure (Set.range (pullback.fst (chart (R := R) a.1 ≫ toSpec 1 R)
      (chart a.2 ≫ toSpec 1 R)).appTop ∪ Set.range (pullback.snd (chart (R := R) a.1 ≫
      toSpec 1 R) (chart a.2 ≫ toSpec 1 R)).appTop) := hclos ▸ Subring.mem_top z
  refine RingHom.mem_range.mp ((Subring.closure_le (t := φ.range)).mpr ?_ hz)
  rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩)
  · have := hα ((Scheme.ΓSpecIso _).hom t)
    simp [sharp] at this
    exact this
  · have := hβ ((Scheme.ΓSpecIso _).hom t)
    simp [sharp] at this
    exact this

/-- **The Segre morphism is a closed immersion.** -/
theorem isClosedImmersion_segre : IsClosedImmersion (segre R) := by
  apply IsZariskiLocalAtTarget.of_iSup_eq_top (U := U 3 R) (iSup_U 3 R)
  intro m
  obtain ⟨a, rfl⟩ := pairEquiv.surjective m
  have hD : U 3 R (pairEquiv a) =
      Proj.basicOpen (homogeneousSubmodule (Fin (3 + 1)) R) (X (segreIdx a)) := rfl
  have hrange : Set.range ((prodCover R).f a) = Set.range (segre R ⁻¹ᵁ U 3 R (pairEquiv a)).ι := by
    rw [Scheme.Opens.range_ι, hD, segre_preimage]
    rfl
  let e := IsOpenImmersion.isoOfRangeEq ((prodCover R).f a) (segre R ⁻¹ᵁ U 3 R (pairEquiv a)).ι
    hrange
  have key : e.hom ≫ segre R ∣_ U 3 R (pairEquiv a) =
      ((prodCover R).X a).toSpecΓ ≫
        Spec.map (CommRingCat.ofHom (awayEvalOf (segreF R a) (X (segreIdx a)) (segreF_unit R a))) ≫
          (Proj.basicOpenIsoSpec (homogeneousSubmodule (Fin (3 + 1)) R) (X (segreIdx a))
            (X_mem_homogeneousSubmodule_one _) Nat.one_pos).inv := by
    refine (cancel_mono (U 3 R (pairEquiv a)).ι).mp ?_
    simp only [Category.assoc, morphismRestrict_ι, IsOpenImmersion.isoOfRangeEq_hom_fac_assoc, e]
    rw [prodCover_f_segre, zpoint, point, Proj.awayι]
    rfl
  rw [← MorphismProperty.cancel_left_of_respectsIso @IsClosedImmersion e.hom, key]
  have : IsAffine ((prodCover R).X a) := IsAffine.of_isPullback (IsPullback.of_hasPullback
    (chart (R := R) a.1 ≫ toSpec 1 R) (chart a.2 ≫ toSpec 1 R))
  have h1 : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (awayEvalOf (segreF R a) (X (segreIdx a)) (segreF_unit R a)))) :=
    IsClosedImmersion.spec_of_surjective _ (awayEvalOf_segre_surjective R a)
  have : IsIso ((prodCover R).X a).toSpecΓ := IsAffine.affine
  have h2 : IsClosedImmersion (Proj.basicOpenIsoSpec (homogeneousSubmodule (Fin (3 + 1)) R)
      (X (segreIdx a)) (X_mem_homogeneousSubmodule_one _) Nat.one_pos).inv := inferInstance
  exact @IsClosedImmersion.comp _ _ _ _ _ inferInstance (@IsClosedImmersion.comp _ _ _ _ _ h1 h2)

end SegreMap

end HodgeLadder.Segre
